<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
@page { size: 650px 20000px; margin: 0; }
body { margin: 0; }
{{ css|safe }}
</style>
<!--
  Fixed, non-editable style block. Comes after the user-authored CSS above
  so it wins the cascade (same specificity, declared later, !important
  beats non-!important). The disclaimer must always render regardless of
  the current CSS -- see design spec / plan Global Constraints. Do NOT
  fold this into the {{ css|safe }} block above; it must stay outside what
  the Design page can edit.
-->
<style>
.disclaimer {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}
</style>
</head>
<body>
<div class="post">
  <div class="header">
    <div class="avatar">{{ avatar_initials }}</div>
    <div class="header-text">
      <div class="name">{{ name }}</div>
      <div class="title">{{ title }}</div>
      <div class="meta">2h &middot; Public</div>
    </div>
  </div>
  <div class="body">
    {% for para in body_paragraphs %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>
  <div class="divider"></div>
  <div class="stats">{{ reactions_fmt }} reactions &middot; {{ comments_fmt }} comments &middot; {{ reposts_fmt }} reposts</div>
  <div class="divider"></div>
  <div class="button-row">
    <div class="button">{{ icons.THUMBS_UP|safe }}<span>Like</span></div>
    <div class="button">{{ icons.MESSAGE_CIRCLE|safe }}<span>Comment</span></div>
    <div class="button">{{ icons.REPEAT_2|safe }}<span>Repost</span></div>
    <div class="button">{{ icons.SEND|safe }}<span>Send</span></div>
  </div>
  <!--
    Inline style attribute: belt-and-braces on top of the fixed <style>
    block above. A selector-based rule can always be crafted with higher
    specificity than that block's `.disclaimer{...}` (e.g.
    `.post .disclaimer{...}`), which would beat it regardless of source
    order since !important rules are still sorted by specificity first.
    An inline style attribute carries higher specificity than any
    selector, so this is the layer that cannot be out-specificity'd.
  -->
  <div class="disclaimer" style="display: block !important; visibility: visible !important; opacity: 1 !important;">
    <div>FICTIONAL TEST POST &middot; NOT LINKEDIN DATA</div>
    <div>FICTIONAL SATIRE</div>
  </div>
</div>
</body>
</html>
